{
  "expo": {
    "name": "ModelHub",
    "slug": "modelhub",
    "owner": "muzammildaku",
    "version": "1.0.0",
    "scheme": "modelhub",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-font",
      "expo-build-properties",
      "expo-web-browser",
      "expo-router",
      "expo-splash-screen"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#3730a3"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4f46e5"
      },
      "package": "com.muzammildaku.modelhub",
      "intentFilters":[
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "modelhub" 
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "extra": {
      "eas": {
        "projectId": "fd9f5118-9ea1-40bc-804e-c3852cc9b72a"
      }
    }
  }
}
